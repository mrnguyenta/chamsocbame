# Bỏ trống DATABASE_URL => chế độ demo với dữ liệu mẫu (dùng để trình bày).
DATABASE_URL=
# Chuỗi ngẫu nhiên ≥ 32 ký tự để ký cookie đăng nhập.
SESSION_SECRET=
# Mã để tài khoản đầu tiên nhận quyền quản trị hệ thống ở trang /quan-tri.
ADMIN_SETUP_KEY=
# Giống backend; dùng khi trang /quan-tri đăng ký webhook cho bot.
TELEGRAM_WEBHOOK_SECRET=
# Địa chỉ máy chủ backend (mặc định https://chamsocnguoithan-api.vercel.app).
API_URL=
# Dự phòng: bot, link Store và email liên hệ thường được nhập ở trang /quan-tri (lưu trong app_settings).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_WATCH_APP_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
