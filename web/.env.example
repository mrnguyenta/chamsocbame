# Bỏ trống DATABASE_URL => chế độ demo với dữ liệu mẫu (dùng để trình bày).
DATABASE_URL=
# Cùng bot với backend; dùng để kiểm tra đăng nhập Telegram.
TELEGRAM_BOT_TOKEN=
# Tên bot không có @, ví dụ ChamSocBaMe_bot. Đặt domain cho bot bằng /setdomain trong @BotFather.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Chuỗi ngẫu nhiên ≥ 32 ký tự để ký cookie đăng nhập.
SESSION_SECRET=
# Link trang ứng dụng đồng hồ trên Connect IQ Store (sau khi phát hành), để trang "Kết nối đồng hồ" hiện mã QR.
NEXT_PUBLIC_WATCH_APP_URL=
