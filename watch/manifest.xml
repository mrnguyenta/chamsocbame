<?xml version="1.0"?>
<!--
    Chăm Sóc Ba Mẹ - Garmin Connect IQ watch app.

    Background service sends on-watch health data every 5 minutes through the
    paired phone (Garmin Connect app, Bluetooth) to our backend.

    Manifest structure and product ids follow house-of-abbey/GarminHomeAssistant (MIT).
    Product ids below were all verified present in that project's manifest.xml.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
  <iq:application id="446e5af5-d06c-401c-a181-5600ec61a835" type="watch-app" name="@Strings.AppName" entry="ChamSocApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.1.0">
    <iq:products>
      <iq:product id="fenix7"/>
      <iq:product id="fenix7s"/>
      <iq:product id="fenix7x"/>
      <iq:product id="fenix7pro"/>
      <iq:product id="fenix7spro"/>
      <iq:product id="fenix7xpro"/>
      <iq:product id="venu3"/>
      <iq:product id="venu3s"/>
      <iq:product id="venu441mm"/>
      <iq:product id="venu445mm"/>
      <iq:product id="vivoactive5"/>
      <iq:product id="vivoactive6"/>
    </iq:products>
    <iq:permissions>
      <iq:uses-permission id="Background"/>
      <iq:uses-permission id="Communications"/>
      <iq:uses-permission id="SensorHistory"/>
      <iq:uses-permission id="UserProfile"/>
    </iq:permissions>
    <iq:languages>
      <iq:language>vie</iq:language>
      <iq:language>eng</iq:language>
    </iq:languages>
    <iq:barrels/>
  </iq:application>
</iq:manifest>
