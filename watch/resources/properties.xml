<?xml version="1.0" encoding="utf-8"?>
<!--
  Application properties, editable from the phone:
  Garmin Connect app -> Thiết bị -> Hoạt động & Ứng dụng / Connect IQ -> Chăm Sóc Ba Mẹ -> Cài đặt.
-->
<properties>
  <!-- e.g. https://xxx.vercel.app (no trailing slash needed, it is stripped) -->
  <property id="server_url" type="string"></property>
  <!-- Sent as "Authorization: Bearer <device_key>" -->
  <property id="device_key" type="string"></property>
  <!-- Minutes between background sends. Connect IQ minimum is 5. -->
  <property id="interval_min" type="number">5</property>
</properties>
