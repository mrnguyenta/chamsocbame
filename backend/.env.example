# Chuỗi kết nối Supabase (Project Settings → Database → Connection pooling, chế độ transaction, cổng 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<mat-khau>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Lấy từ @BotFather
TELEGRAM_BOT_TOKEN=
# Chuỗi ngẫu nhiên, dùng khi gọi setWebhook (secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Chuỗi ngẫu nhiên, giống giá trị lưu trong Supabase Vault (supabase/cron.sql)
CRON_SECRET=
# Tạo bằng: python -c "from chamsoc.crypto import generate_key; print(generate_key())"
TOKEN_ENCRYPTION_KEY=
# none = chưa gọi điện thật (để sẵn, tích hợp sau)
CALL_PROVIDER=none
